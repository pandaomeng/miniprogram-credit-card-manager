<view class="page">
  <view class="search-wrap">
    <input
      class="search-input"
      type="text"
      placeholder="搜索银行名称或代码（如 招商、CMB）"
      value="{{keyword}}"
      confirm-type="done"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
  </view>

  <scroll-view scroll-y class="list" show-scrollbar="{{false}}">
    <view wx:if="{{list.length === 0 && keywordTrim}}" class="empty-hint">
      无匹配结果，点键盘「完成」或下方按钮返回并保存该名称
    </view>
    <view
      class="bank-item"
      wx:for="{{list}}"
      wx:key="code"
      data-code="{{item.code}}"
      data-name="{{item.name}}"
      bindtap="onPickBank"
    >
      <text class="bank-name">{{item.name}}</text>
      <text class="bank-code">{{item.code}}</text>
    </view>
  </scroll-view>

  <view class="confirm-footer" wx:if="{{list.length === 0 && keywordTrim}}">
    <view class="btn-confirm" catchtap="onSearchConfirm">确认并返回</view>
  </view>
</view>
