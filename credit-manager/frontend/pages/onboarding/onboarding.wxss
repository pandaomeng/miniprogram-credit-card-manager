.page {
  min-height: 100vh;
  background: linear-gradient(165deg, #1a1a2e 0%, #2d3a5c 45%, #16213e 100%);
  box-sizing: border-box;
  position: relative;
}

.skip {
  position: absolute;
  right: 32rpx;
  top: 0;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  z-index: 2;
}

.swiper {
  height: 62vh;
  margin-top: 80rpx;
}

.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 64rpx;
  box-sizing: border-box;
}

.slide-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  margin-bottom: 28rpx;
  line-height: 1.35;
}

.slide-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
  line-height: 1.65;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 0 48rpx;
}

.start {
  width: 100% !important;
  background: #fff !important;
  color: #1a1a2e !important;
  font-weight: 600;
  border: none;
}

.start::after {
  border: none;
}
