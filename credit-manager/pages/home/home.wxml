<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner" style="padding-right: {{navRightPaddingPx}}px;">
      <text class="nav-title">账期管家</text>
      <view class="nav-add" bindtap="onAdd" aria-label="添加信用卡">＋</view>
    </view>
  </view>

  <view class="body" wx:if="{{totalCount > 0}}">
    <view class="ym-bar">
      <picker mode="multiSelector" range="{{ymMultiRange}}" value="{{ymMultiIndex}}" bindchange="onYmMultiChange">
        <view class="ym-picker-trigger">
          <text class="ym-text">{{isCurrentViewMonth ? '本月' : ymDisplay}}</text>
          <text class="ym-caret">▼</text>
        </view>
      </picker>
      <view class="ym-actions" wx:if="{{!isCurrentViewMonth}}">
        <view class="ym-quick" bindtap="onGoCurrentMonth">切换到本月</view>
      </view>
    </view>

    <view class="section-head">
      <text class="section-label">我的信用卡</text>
      <view class="filter-row">
        <text class="filter-text">隐藏已还款</text>
        <switch
          checked="{{hideRepaid}}"
          color="#2d3a5c"
          bindchange="onHideRepaidChange"
        />
      </view>
    </view>

    <block wx:if="{{cards.length}}">
      <view class="swipe-wrap" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtouchstart="onCardTouchStart" bindtouchmove="onCardTouchMove" bindtouchend="onCardTouchEnd" bindtouchcancel="onCardTouchEnd">
        <view class="swipe-actions">
          <view class="swipe-delete" catchtap="onSwipeDelete" data-id="{{item.id}}">删除</view>
        </view>
        <view
          class="swipe-content {{openSwipeId === item.id ? 'open' : ''}}"
          bindtap="onOpenCard"
          data-id="{{item.id}}"
        >
          <view class="card-row {{item.repaid_active ? 'is-repaid' : ''}}">
            <view class="repay-hit" catchtap="onToggleRepaid" data-id="{{item.id}}">
              <view class="repay-check {{item.repaid_active ? 'on' : ''}}">
                <text class="repay-tick" wx:if="{{item.repaid_active}}">✓</text>
              </view>
            </view>
            <image class="bank-logo" src="{{item.logo_path}}" mode="aspectFit" />
            <view class="card-main" bindlongpress="onLongPressCard" data-id="{{item.id}}">
              <view class="row-top">
                <view class="name-wrap">
                  <text class="bank-name">{{item.bank_name}}</text>
                  <text class="repaid-badge" wx:if="{{item.repaid_active}}">已还款</text>
                </view>
                <text class="last4">{{item.card_display}}</text>
              </view>
              <view class="row-meta">
                <text>账单日 每月 {{item.bill_day}} 日</text>
                <text class="dot">·</text>
                <text>还款日 每月 {{item.due_day}} 日</text>
              </view>
              <view class="row-due repaid-line" wx:if="{{item.repaid_active}}">{{repaidLineText}}</view>
              <view class="row-due {{item.due_urgent ? 'urgent' : ''}}" wx:else>
                距下次还款还有 {{item.days_until_due}} 天
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="filter-empty" wx:else>
      <text class="filter-empty-title">已全部还清或未展示</text>
      <text class="filter-empty-sub">已开启「隐藏已还款」，当前没有待还卡片。关闭开关可重新显示。</text>
      <view class="filter-empty-btn" bindtap="onShowRepaidCards">显示已还款卡片</view>
    </view>

    <view class="list-footer-add">
      <view class="btn-primary list-add-btn" bindtap="onAdd">添加信用卡</view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-illus" aria-hidden="true">💳</view>
    <text class="empty-title">还没有信用卡</text>
    <text class="empty-sub">添加第一张卡，开始管理账单日与还款日</text>
    <button class="empty-btn btn-primary" bindtap="onAdd">添加第一张信用卡</button>
  </view>
</view>
