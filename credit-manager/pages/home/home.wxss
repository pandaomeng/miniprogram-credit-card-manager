.page {
  min-height: 100vh;
  background: #f5f6fa;
}

.nav {
  background: #1a1a2e;
  color: #fff;
}

.nav-inner {
  height: 88rpx;
  padding-left: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.nav-add {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

.body {
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.section-head {
  margin: 8rpx 8rpx 20rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.05);
}

.filter-text {
  font-size: 28rpx;
  color: #444;
}

.filter-empty {
  padding: 56rpx 32rpx 40rpx;
  text-align: center;
}

.filter-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 16rpx;
}

.filter-empty-sub {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.55;
  margin-bottom: 32rpx;
}

.filter-empty-btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  color: #2d3a5c;
  border: 2rpx solid #2d3a5c;
  border-radius: 999rpx;
}

.card-row {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 26, 46, 0.06);
}

.card-row.is-repaid {
  background: #f8f9fc;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.04);
}

.repay-hit {
  width: 56rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
}

.repay-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #c5c9d4;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.repay-check.on {
  border-color: #2d3a5c;
  background: #2d3a5c;
}

.repay-tick {
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
}

.bank-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f0f2f8;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.name-wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.bank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.repaid-badge {
  font-size: 22rpx;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.3;
  font-weight: 500;
}

.last4 {
  font-size: 26rpx;
  color: #666;
  font-variant-numeric: tabular-nums;
}

.row-meta {
  font-size: 24rpx;
  color: #777;
  margin-bottom: 10rpx;
}

.dot {
  margin: 0 8rpx;
  color: #ccc;
}

.row-due {
  font-size: 24rpx;
  color: #2e7d32;
}

.row-due.urgent {
  color: #e53935;
  font-weight: 600;
}

.row-due.repaid-line {
  color: #78909c;
  font-weight: 400;
}

.empty {
  padding: 120rpx 56rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-illus {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.85;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #888;
  line-height: 1.55;
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 100%;
  max-width: 520rpx;
}
