.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6fa;
  box-sizing: border-box;
}

.search-wrap {
  padding: 20rpx 24rpx 12rpx;
  flex-shrink: 0;
}

.search-input {
  height: 80rpx;
  padding: 0 28rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.list {
  flex: 1;
  height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.empty-hint {
  padding: 48rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

.bank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.05);
}

.bank-name {
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.bank-code {
  font-size: 24rpx;
  color: #999;
  font-variant-numeric: tabular-nums;
}

.footer {
  flex-shrink: 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #eee;
}

.custom-bar {
  text-align: center;
  font-size: 28rpx;
  color: #2d3a5c;
  padding: 16rpx 0;
}

.custom-panel {
  margin-top: 8rpx;
}

.custom-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.btn-confirm {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(135deg, #2d3a5c 0%, #1a1a2e 100%);
}
