.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.field {
  margin-bottom: 36rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 30rpx;
}

.picker-value {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 30rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #aaa;
}

.bank-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bank-row-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}

.bank-row-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #bbb;
  line-height: 1;
  font-weight: 300;
}

.actions {
  margin-top: 56rpx;
}

.actions .btn-primary {
  margin-bottom: 24rpx;
}

.actions .btn-ghost {
  margin-bottom: 0;
}
